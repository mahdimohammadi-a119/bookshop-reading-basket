{
  "framework": "vite",
  "buildCommand": "npm run build",
  "devCommand": "npx vite --port $PORT --strictPort",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "^/(?!api/|src/|@|node_modules/|assets/|covers/)(?!.*\\.[A-Za-z0-9]+$).*$",
      "dest": "/index.html"
    }
  ]
}
